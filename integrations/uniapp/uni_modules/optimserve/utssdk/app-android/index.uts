import OptimServeSession from 'agency.optimserve.nativecore.OptimServeSession'
import ResultListener from 'agency.optimserve.nativecore.OptimServeSession.ResultListener'
import Listener from 'agency.optimserve.nativecore.OptimServeSession.Listener'
import JSONObject from 'org.json.JSONObject'
import Handler from 'android.os.Handler'
import Looper from 'android.os.Looper'
import {ConfigOptions,Completion} from '../interface.uts'
let session: OptimServeSession|null = null
function ui(work:()=>void):void { new Handler(Looper.getMainLooper()).post(work) }
class Reply implements ResultListener {
  done:Completion
  constructor(done:Completion){this.done=done}
  override complete(json:string|null,error:string|null):void { this.done(error!=null?{error:error}:JSON.parseObject(json!)!) }
}
class Events implements Listener {
  options:ConfigOptions
  constructor(options:ConfigOptions){this.options=options}
  override onEvent(event:JSONObject):void { this.options.onEvent?.(JSON.parseObject(event.toString())!) }
}
export function configure(options:ConfigOptions,done:Completion):void {
  ui(()=>{try {session?.close();session=new OptimServeSession(UTSAndroid.getAppContext()!,options.appKey,options.appName,options.appId);session!.setListener(new Events(options));done({ok:true})}catch(e){done({error:'Check your App Key and App ID.'})}})
}
export function prepare(stream:string,streamId:string|null,done:Completion):void {
  ui(()=>{try {if(session==null){done({error:'Create the OptimServe session first.'});return}session!.prepareJSON(stream,streamId,new Reply(done))}catch(e){done({error:'Use an HTTPS media URL and a valid optional Stream ID.'})}})
}
export function updatePlayback(state:string,bufferedMs:number,positionMs:number):void {ui(()=>{session?.updatePlayback(state,bufferedMs,positionMs)})}
export function setBackground(value:boolean):void {ui(()=>{session?.setBackground(value)})}
export function snapshot(done:Completion):void {ui(()=>{done(session==null?{error:'No active session'}:JSON.parseObject(session!.snapshot().toString())!)})}
export function stop():void {ui(()=>{session?.stop()})}
export function close():void {ui(()=>{session?.close();session=null})}
